# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local assistant/editor config
.claude/

# Local test/cache artifacts created in this workspace
pytest-cache-files-*/

# Build/distribution
build/
dist/
*.egg-info/

# Runtime outputs
outputs/**
!outputs/.gitkeep

# Binary sample data (keep docs, ignore large local files)
*.xlsx
!data/samples/.gitkeep

# Optional env files
.env
.env.*
env/*.env
!env/*.env.example
