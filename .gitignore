# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.python-version

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local assistant/editor config
.claude/

# Local test/cache artifacts created in this workspace
pytest-cache-files-*/

# Build/distribution
build/
dist/
*.egg-info/

# Streamlit local secrets/config overrides
.streamlit/secrets.toml

# Runtime outputs
outputs/**
!outputs/.gitkeep

# Binary sample data (keep docs, ignore large local files)
*.xlsx
!data/samples/.gitkeep
~$*.xlsx

# Optional env files
.env
.env.*
env/*.env
!env/*.env.example

# Local misc artifacts
*.log
*.tmp
*.bak
